IMPLICIT_WAIT=10
EXPLICIT_WAIT=45
# Секунды ожидания body+readyState после открытия URL (page_load_strategy=none)
DOCUMENT_READY_TIMEOUT=120
VPS_LIGHT_MODE=true

AVITO_BASE_URL=https://www.avito.ru
WB_BASE_URL=https://www.wildberries.ru

# Avito: капча — столько попыток на КАЖДУЮ страницу (счётчик сбрасывается при переходе на след. стр.)
AVITO_BLOCK_MAX_RETRIES_PER_PAGE=5
# Пауза между попытками (сек), чтобы успел смениться IP у мобильного прокси
AVITO_BLOCK_RETRY_WAIT_SEC=130
AVITO_MAX_PAGES_PER_RUN=5
# DOM-загрузка (слабый VPS + мобильный прокси): сколько ждать карточки/панель перед перезаходом
AVITO_DOM_RELOAD_TRIES=5
AVITO_DOM_WAIT_SHELL_FIRST=95
AVITO_DOM_WAIT_SHELL_NEXT=70
AVITO_DOM_WAIT_FILTERS_FIRST=80
AVITO_DOM_WAIT_FILTERS_NEXT=60

# Optional: path to preinstalled chromedriver binary on VPS
# CHROMEDRIVER_PATH=/usr/bin/chromedriver
