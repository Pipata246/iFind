BOT_TOKEN=
SUPABASE_URL=
SUPABASE_ANON_KEY=

USE_MOBILE_PROXY=true
MOBILE_PROXY_HOST=91.221.70.204
MOBILE_PROXY_PORT=10237
MOBILE_PROXY_USER=OU9tLKqk63
MOBILE_PROXY_PASS=t8cfLDzi55

IMPLICIT_WAIT=10
EXPLICIT_WAIT=45
# Секунды ожидания body+readyState после открытия URL (page_load_strategy=none)
DOCUMENT_READY_TIMEOUT=120
VPS_LIGHT_MODE=true
# Те же «лёгкие» флаги Chrome, что и при VPS_LIGHT_MODE (можно включить отдельно).
AVITO_LIGHTWEIGHT_CHROME=true
TELEGRAM_SHOW_BROWSER=false

AVITO_BASE_URL=https://www.avito.ru
WB_BASE_URL=https://www.wildberries.ru

# Avito: капча — столько попыток на КАЖДУЮ страницу (счётчик сбрасывается при переходе на след. стр.)
AVITO_BLOCK_MAX_RETRIES_PER_PAGE=5
# Пауза между попытками (сек), чтобы успел смениться IP у мобильного прокси
AVITO_BLOCK_RETRY_WAIT_SEC=130
AVITO_MAX_PAGES_PER_RUN=5
# DOM-загрузка (слабый VPS + мобильный прокси): сколько ждать карточки/панель перед перезаходом
AVITO_DOM_RELOAD_TRIES=5
AVITO_DOM_WAIT_SHELL_FIRST=95
AVITO_DOM_WAIT_SHELL_NEXT=70
AVITO_DOM_WAIT_FILTERS_FIRST=80
AVITO_DOM_WAIT_FILTERS_NEXT=60
AVITO_ENTER_THROTTLE_MIN_SEC=120
AVITO_ENTER_THROTTLE_MAX_SEC=180
AVITO_WAIT_NEW_IP_TIMEOUT_SEC=420
AVITO_WAIT_NEW_IP_POLL_SEC=12
AVITO_COOLDOWN_AFTER_NEW_IP_SEC=12
AVITO_PAGES_BATCH_SIZE=25
AVITO_RUN_RESTART_ATTEMPTS=2
AVITO_RUN_RESTART_BACKOFF_SEC=30
AVITO_RUN_RESTART_BACKOFF_JITTER_SEC=15

# Повторы открытия страницы (timeout / transport / прочее) с backoff из env
AVITO_PAGE_LOAD_MAX_RETRIES=5
AVITO_RETRY_BACKOFF_BASE_SEC=8
AVITO_RETRY_BACKOFF_MAX_SEC=120
AVITO_RETRY_JITTER_SEC=4

# Пересоздание Chrome после N страниц на слабом VPS (0 = выкл.)
AVITO_DRIVER_RECYCLE_AFTER_PAGES=0
AVITO_DRIVER_RECYCLE_AFTER_ERRORS=0

# Optional: path to preinstalled chromedriver binary on VPS
# CHROMEDRIVER_PATH=/usr/bin/chromedriver
# Optional: explicit path to Chrome/Chromium binary on VPS
# CHROME_BINARY=/usr/bin/google-chrome
# CHROME_BINARY=/usr/bin/chromium
